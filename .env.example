# WebUntis credentials (required)
UNTIS_USER=
UNTIS_PASS=

# WebUntis instance (defaults match LE-BK Münster)
UNTIS_HOST=le-bk-muenster.webuntis.com
UNTIS_SCHOOL=le-bk-muenster

# Only scrape these subjects (comma separated, short names). Empty = all.
#SUBJECT_FILTER=STDM,EVP,SP,E,D,D-KRYPT,WBL

# Weekly auto-scrape: day (mon..sun, "off" disables) and time, container TZ
SCRAPE_DAY=sun
SCRAPE_TIME=18:00
