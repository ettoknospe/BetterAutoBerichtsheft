# WebUntis credentials (required)
UNTIS_USER=
UNTIS_PASS=

# WebUntis instance 
UNTIS_HOST=
UNTIS_SCHOOL=


# Weekly auto-scrape: day (mon..sun, "off" disables) and time, container TZ
SCRAPE_DAY=sun
SCRAPE_TIME=18:00

# IHK tibrosBB portal credentials (required for "Bei IHK einreichen")
IHK_USER=
IHK_PASS=

# IHK portal host 
IHK_HOST=

# Optional overrides for a brand-new entry's "Ausbildungsabschnitt" / supervisor
# email fields. The portal normally pre-fills both from account defaults, but
# these force a specific value if that ever isn't the case.
#IHK_AUSBABSCHNITT=
#IHK_AUSB_MAIL=
