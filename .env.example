# WebUntis credentials (required)
UNTIS_USER=
UNTIS_PASS=

# WebUntis instance
UNTIS_HOST=
UNTIS_SCHOOL=


# Weekly auto-scrape: day (mon..sun, "off" disables) and time, container TZ
SCRAPE_DAY=sun
SCRAPE_TIME=18:00

# IHK tibrosBB portal credentials (required for "Bei IHK einreichen")
IHK_USER=
IHK_PASS=

# IHK portal host
IHK_HOST=

# Optional overrides for a brand-new entry's "Ausbildungsabschnitt" / supervisor
# email fields. The portal normally pre-fills both from account defaults, but
# these force a specific value if that ever isn't the case.
#IHK_AUSBABSCHNITT=
#IHK_AUSB_MAIL=

# Multi-user auth (required after first migration)
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Bootstrap admin account on first migration (if UNTIS_USER is set)
# If unset, use `python -m app.create_admin` to create the first admin manually.
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=
