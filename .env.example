# WebUntis credentials (required)
UNTIS_USER=
UNTIS_PASS=

# WebUntis instance (defaults match LE-BK Münster)
UNTIS_HOST=le-bk-muenster.webuntis.com
UNTIS_SCHOOL=le-bk-muenster

# Only scrape these subjects (comma separated, short names). Empty = all.
#SUBJECT_FILTER=STDM,EVP,SP,E,D,D-KRYPT,WBL

# Weekly auto-scrape: day (mon..sun, "off" disables) and time, container TZ
SCRAPE_DAY=sun
SCRAPE_TIME=18:00

# IHK tibrosBB portal credentials (required for "Bei IHK einreichen")
IHK_USER=
IHK_PASS=

# IHK portal host (defaults match IHK Nord Westfalen)
IHK_HOST=www.bildung-ihk-nordwestfalen.de

# Optional overrides for a brand-new entry's "Ausbildungsabschnitt" / supervisor
# email fields. The portal normally pre-fills both from account defaults, but
# these force a specific value if that ever isn't the case.
#IHK_AUSBABSCHNITT=18.42
#IHK_AUSB_MAIL=
